{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-gym.example.invalid/schemas/scenario-pack.v1.json",
  "title": "Evidence Gym Scenario Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "locales", "audience", "license", "review", "missions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" } },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAge", "primary"],
      "properties": {
        "minimumAge": { "type": "integer", "minimum": 13, "maximum": 30 },
        "primary": { "enum": ["student", "young_adult", "educator", "community"] }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "attribution"],
      "properties": {
        "identifier": { "type": "string", "maxLength": 80 },
        "attribution": { "type": "string", "maxLength": 1000 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerIds", "reviewedAt", "expiresAt"],
      "properties": {
        "reviewerIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "contentWarnings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string", "pattern": "^missions/[A-Za-z0-9._-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
